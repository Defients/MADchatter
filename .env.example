# Optional Express backend configuration (npm run server).
# Copy to .env only if you need backend routes; do not overwrite an existing .env.
# Browser AI keys are configured in Settings -> API Config, not here.
# Keep real keys/secrets out of version control. See docs/SETUP.md.

# Runtime: empty PORT uses 3000; empty NODE_ENV uses development mode.
# NODE_ENV=production serves the built dist/ directory instead of Vite middleware.
PORT=
NODE_ENV=

# Backend Twitch OAuth. APP_URL is a base URL without a trailing slash.
# These values do NOT change the frontend's fixed callback URLs.
APP_URL=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=

# Backend token-exchange fallback credentials.
# Do not move client secrets into VITE_ variables; those are exposed to browsers.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
JOYSTICK_CLIENT_ID=
JOYSTICK_CLIENT_SECRET=

# Optional backend provider-key fallbacks.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional backend Deepgram key retrieval.
DEEPGRAM_API_KEY=
